# ==========================================
# MeetingMind Environment Configuration (.env)
# ==========================================
# Copy this file to .env and customize for local or Docker deployment.
# Never commit the actual .env file or production secrets to Git.

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_DB=meetingmind
POSTGRES_USER=meetingmind
POSTGRES_PASSWORD=meetingmind

# For local backend running outside Docker:
DATABASE_URL=jdbc:postgresql://localhost:5433/meetingmind
DATABASE_USERNAME=meetingmind
DATABASE_PASSWORD=meetingmind

# --- Redis ---
REDIS_PASSWORD=

# --- Kafka ---
# External client port exposed on host
KAFKA_PORT=9092

# --- AI Provider (Grok / xAI) ---
GROQ_API_KEY=your-groq-api-key-here

# --- Spring Security & JWT ---
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Port Mappings (Host Ports) ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6380
ZIPKIN_PORT=9411
PGADMIN_PORT=5050

# --- Frontend Application URL (for OAuth callbacks) ---
FRONTEND_URL=http://localhost:3000
